# Variables para docker-compose.yml. Copiar como ".env" y completar.
# Nunca subir el archivo .env con valores reales (está en .gitignore).
# Cada variable está explicada en la sección "Configuración" del README.

# MySQL (la API, la migración y la generación de datos usan MYSQL_USER y MYSQL_PASSWORD)
MYSQL_ROOT_PASSWORD=cambiar_esta_contrasena
MYSQL_DATABASE=battlehub_profiles
MYSQL_USER=battlehub
MYSQL_PASSWORD=cambiar_esta_contrasena

# Auth0: dominio del tenant del proyecto e Identifier de la API (Shell -> Profile)
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.battlehub.local/profile

# Auth0: aplicación M2M de Profile para Auth0 Management API (R-47, R-48)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_MGMT_AUDIENCE=

# Auth0: Identifier de la API de cada juego, donde vive su permiso games.<tipo>.play.
# Los tres son obligatorios: si falta uno, la API no arranca, porque ese juego quedaría
# invisible para todos los usuarios sin dar ningún error.
AUTH0_API_TYPING=https://api.battlehub.local/typing
AUTH0_API_TRIVIA=https://api.battlehub.local/trivia
AUTH0_API_MEMORY=https://api.battlehub.local/memory

# Auth0: API de Matchmaking (opcional). El permiso matches.create se asigna en la API de
# Profile (AUTH0_AUDIENCE); defina esto solo si el Equipo 2 llegara a moverlo a su API.
AUTH0_API_MATCHMAKING=

# Orígenes del Shell permitidos por CORS
CORS_ORIGIN=http://localhost:4000
# URL donde se publique el Shell, por ejemplo https://shell.ejemplo.com (opcional)
CORS_ORIGIN_PUBLISHED=

# Redirección a HTTPS. Dejar en false mientras la API solo escuche HTTP
# (en el contenedor, o detrás de un proxy que ya maneja HTTPS)
HTTPS_REDIRECT=false

# Puerto local donde queda publicada la API
PROFILE_API_PORT=5220
