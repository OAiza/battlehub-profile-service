# Variables para docker-compose.yml. Copiar como ".env" y completar.
# Nunca subir el archivo .env con valores reales (está en .gitignore).

# MySQL
MYSQL_ROOT_PASSWORD=cambiar_esta_contrasena
MYSQL_DATABASE=battlehub_profiles
MYSQL_USER=battlehub
MYSQL_PASSWORD=cambiar_esta_contrasena

# Auth0 (tenant del proyecto; ver ADR-006 y ADR-007)
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.battlehub.local/profile

# Origen del Shell permitido por CORS (ADR-003 y ADR-006)
CORS_ORIGIN=http://localhost:4000

# Puerto local donde queda publicada la API
PROFILE_API_PORT=5220
